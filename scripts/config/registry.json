{
 "how": "One row per data source: the single list of what feeds the site. build_manifest.py reads this and writes meta-log/data/manifest.json (file sizes and how fresh each output is). Add a row here when adding a source; keep docs/UPDATING.md in step.",
 "sources": [
  {
   "id": "health",
   "name": "Apple Health",
   "kind": "manual export",
   "raw": "jsbv data/health export YYYY-MM-DD/",
