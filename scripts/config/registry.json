   ],
   "pages": [
    "writing/",
    "/#explore"
   ],
   "stale_days": null,
   "run": {
    "order": 62,
    "label": "Writing",
    "find": [
     {
      "glob": [
       "*[Ww]riting*[Ll]og*.xlsx"
      ]
     }
    ],
    "args": [
     "{0}",
     "{data}"
    ],
    "export": {
     "table": "writing",
     "date": "date",
     "out": "meta-log/data/writing.json",
     "start": "first",
     "empty_ok": true,
     "dataset": {
      "id": "writing",
      "name": "Writing",
      "source": "Writing log workbook (writing/)"
     },
     "metrics": [
      {
       "id": "words",
       "name": "Words written",
       "unit": "words",
       "agg": "sum",
       "col": "words",
       "color": "#ffd84a",
       "round": 0
      },
      {
       "id": "sessions",
       "name": "Writing sessions",
       "unit": "sessions",
       "color": "#ff6fd8",
       "agg": "sum",
       "col": "session"
      },
      {
       "id": "minutes",
       "name": "Writing time",
       "unit": "min",
       "agg": "sum",
       "col": "minutes",
       "color": "#9b7bff",
       "round": 0
      }
     ],
     "dims": [
      {
       "id": "project",
       "name": "Project",
       "col": "project_id",
       "name_col": "project",
       "rank": "words",
       "metrics": [
        "words",
        "minutes"
       ],
       "cats": "auto"
      },
      {
       "id": "tod",
       "name": "Time of day",
       "col": "tod",
       "metrics": [
        "words"
       ],
       "cats": [
        {
         "id": "night",
         "name": "Night 0–6",
         "color": "#9b7bff"
        },
        {
         "id": "morning",
         "name": "Morning 6–12",
         "color": "#ffb347"
        },
        {
         "id": "afternoon",
         "name": "Afternoon 12–18",
         "color": "#3ff0ff"
        },
        {
         "id": "evening",
         "name": "Evening 18–24",
         "color": "#ff3fb4"
        }
       ]
      }
     ],
     "rows": {
      "out": "writing/data/sessions.json",
      "cols": [
       "date",
       "project_id",
       "notebook",
       "words",
       "start",
       "finish",
       "minutes",
       "music",
       "src"
      ],
      "order": "date, start"
     }
    },
    "opt": [
     {
      "glob": [
       "*Daily Notes*/*.md",
       "*Daily Notes*/*/*.md"
      ],
      "all": true
     }
    ]
