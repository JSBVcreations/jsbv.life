.DS_Store
# raw personal exports never go in this repo (Spotify raw JSON contains IP addresses)
raw/
*.csv
Streaming_History_*.json
~$*
# personal overlay entries that only show on this machine
meta-log/data/life.private.json
# source workbooks stay out of the repo (the watch list names people)
*.xlsx
*.numbers
# data exports (the Epic Games export holds account details, IPs and purchases)
*.pdf
# python bytecode from the scripts folder
__pycache__/
# plain copies of private datasets (published only sealed, as meta-log/data/private.enc.json)
meta-log/data/private/
# AT&T exports and the phone alias key name real people: they live in jsbv data/ATT, never here
ATT-*/
*phone-decoder*.json
*phone-people*
phone-records*.csv
call-matches*.csv
# natal chart source (birth date, time, place): stays local; only what's built from it is committed
JSBV meta/
